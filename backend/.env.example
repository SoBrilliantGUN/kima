# App
APP_NAME=kima
ENVIRONMENT=development          # development | production
DEBUG=true
API_PREFIX=/api                  # 仅作用于业务 router（模块 2+）；/health/* 保持裸挂供探针使用

# Database
DATABASE_URL=postgresql+asyncpg://kima:kima@localhost:5432/kima

# LLM（DeepSeek，OpenAI 兼容）
LLM_PROVIDER=fake                # fake | deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Embedding（SiliconFlow）
EMBEDDING_PROVIDER=fake          # fake | siliconflow
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Rerank（SiliconFlow）
RERANK_PROVIDER=fake             # fake | siliconflow
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.3             # rerank 相关度阈值，低于此分的候选被丢弃（0~1）

# Web Search（博查）
WEB_SEARCH_PROVIDER=fake         # fake | bocha
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.bochaai.com/v1

# RAG 上下文组装
CONTEXT_MAX_TOKENS=6000
HISTORY_RECENT_TURNS=3

# 笔记向量化（idle 触发，秒）
NOTE_REVECTORIZE_IDLE_SECONDS=120

# Copilot 记忆（三型：情节/语义/程序）
MEMORY_EPISODIC_TTL_DAYS=30
MEMORY_RECENCY_WINDOW_DAYS=7
MEMORY_CONFLICT_TOP_K=10
MEMORY_SUPERSEDED_WINDOW_DAYS=7   # 软删除窗口：被 superseded 后 N 天内可召回复活
MEMORY_REVIVAL_SIMILARITY=0.5      # 复活阈值：superseded 记忆与 query 余弦相似度 ≥ 此值才复活

# Copilot 工具结果截断（字符）
COPILOT_MAX_RESULT_CHARS=4000
COPILOT_IDEMPOTENCY_TTL_SECONDS=86400   # 写工具幂等记录 TTL（processing 残留回收，秒）
COPILOT_DOCUMENT_WARN_TOKENS=100000     # 大文档警告阈值：文档嵌入 token 超过此值 → 需用户确认

# Copilot 输出审查（自检节点，必选闸门）：每次产出后对账「声称 vs 工具轨迹」
COPILOT_REVIEW_MAX_ATTEMPTS=2     # 发现不一致时的自动修复重试上限

# Copilot 上下文窗口六层（L0-L5，见 docs/context-window-layering.md）
COPILOT_CONTEXT_MAX_TOKENS=1048576       # window：DeepSeek V4 官方 1M
COPILOT_CONTEXT_L0_RATIO=0.08            # L0 system（超仅告警）
COPILOT_CONTEXT_L1_RATIO=0.15            # L1 state（超仅告警）
COPILOT_CONTEXT_L2_RATIO=0.35            # L2 memory + RAG（超裁剪）
COPILOT_CONTEXT_SKILLS_BUDGET=25000      # L3 skills 全文（独立固定，超截断）
COPILOT_CONTEXT_SAFETY_MARGIN=500        # L5 计算预留的安全余量

# Copilot HITL 分级审批（写工具需人工确认，见 docs/module-6-copilot.md §4.15）
COPILOT_REQUIRE_WRITE_APPROVAL=false   # 总开关：是否启用写工具审批
COPILOT_APPROVAL_MODE=graded           # graded（仅 HIGH 审批，MEDIUM 自动放行+审计）| strict（全写审批）
COPILOT_APPROVAL_TIMEOUT_SECONDS=900   # 审批超时 fail-close（默认 15 分钟，过期即阻断）

# Copilot Agent 权限系统（穷举爆破 / 出站 DLP / 安全熔断，见 docs/module-6-copilot.md §4.14）
COPILOT_BUDGET_MAX_TOOL_CALLS=50       # 单 run 工具调用次数上限（穷举爆破第五轴）
COPILOT_LLM_DLP_REDACT=true            # LLM 上下文发往模型服务商前脱敏（身份证/银行卡/手机号等）
COPILOT_SECURITY_BREAKER_ENABLED=false # 安全熔断开关（反复参数契约违规→冻结 run，手动恢复）
COPILOT_SECURITY_BREAKER_THRESHOLD=5   # 熔断阈值（连续 N 次参数契约违规）
COPILOT_CACHE_HIT_RATE_WARN=0.3        # 前缀缓存命中率告警阈值（低于此值且输入量够大 → warning）

# 实时计费（价格时变主数据 + 调用级成本审计，见 docs/pricing.md）
COPILOT_PRICING_CHECK_ENABLED=true     # 启动「未来 3 天价格覆盖」校验（真实提供方才生效）
COPILOT_PRICING_CACHE_TTL_SECONDS=60   # 价格解析内存缓存 TTL（秒）

# Worker 偷懒（事件驱动 idle 兜底，秒）
WORKER_IDLE_FALLBACK_SECONDS=300

# LangFuse 可观测（无 key 默认关）
LANGFUSE_PROVIDER=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# MinerU
MINERU_API_BASE_URL=
MINERU_API_TOKEN=

# CORS
CORS_ORIGINS=http://localhost:5173
